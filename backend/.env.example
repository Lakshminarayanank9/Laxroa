NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/laxroa

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-string

# Allowed website origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://qivra.co.in,https://www.qivra.co.in
FRONTEND_URL=https://www.qivra.co.in

# Used only by the seed script
ADMIN_EMAIL=admin@qivra.co.in
ADMIN_PASSWORD=ChangeThisNow#123

# Optional product image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset email (Resend; use a verified sender domain)
EMAIL_API_KEY=
EMAIL_FROM="QIVRA <no-reply@qivra.co.in>"
